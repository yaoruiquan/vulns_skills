# CNVD 每周数据库更新 skill 本地配置示例
# 复制为 .env 后填写真实值；.env 已被仓库忽略，不要提交。

# 钉钉自定义机器人 webhook
DINGTALK_WEBHOOK=

# 钉钉机器人加签密钥；未启用加签时留空
DINGTALK_SECRET=

# 是否启用钉钉通知：true/false
DINGTALK_ENABLED=true

# === CNVD 周库任务运行配置 ===
# 运行模式：update=上传并入库，check=只检查 XML/SSH/Docker 环境
CNVD_WEEKLY_MODE=update

# 是否只演练命令，不执行远端写入：true/false
CNVD_WEEKLY_DRY_RUN=false

# 是否让 cnvd_weekly_update.sh 在成功/失败时调用钉钉通知：true/false
CNVD_WEEKLY_DINGTALK_NOTIFY=false

# 输出目录；默认可留空，由脚本写入当前 job 的 output 目录
# OUTPUT_DIR=/path/to/output
